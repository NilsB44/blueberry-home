# Copy to .env and adjust.

# On the Pi: served over HTTPS at https://hub.home (see docs/pi-setup.md).
HUB_HOSTNAME=hub.home

# Trying it on a laptop before the Pi arrives? Use plain HTTP instead
# (see docs/try-it-now.md):
# HUB_HOSTNAME=:80
# HUB_COOKIE_SECURE=false

# Point at another machine's Ollama (e.g. a desktop with a GPU) instead of the Pi's own.
# HUB_OLLAMA_URL=http://192.168.1.50:11434
HUB_ASSISTANT_MODEL=qwen3:4b
