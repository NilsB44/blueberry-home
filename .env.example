# Copy to .env and adjust.

# On the Pi: served over HTTPS at https://hub.home (see docs/pi-setup.md).
HUB_HOSTNAME=hub.home
# For away access over Tailscale, add the Pi's Tailscale name (see docs/security.md):
# HUB_HOSTNAME="hub.home, hub.tail1234.ts.net"

# The hub only answers to local names (*.home, *.lan, *.local, *.ts.net, IP addresses), so a
# website can't reach it by pointing its own domain at the Pi. Using a real domain of your own?
# List it here too:
# HUB_ALLOWED_HOSTS=["hub.example.com"]

# Trying it on a laptop before the Pi arrives? Use plain HTTP instead
# (see docs/try-it-now.md):
# HUB_HOSTNAME=:80
# HUB_COOKIE_SECURE=false

# Who can use the hub without a password. Defaults to the private (home network) ranges.
# Don't add your VPN here: reaching the hub from outside goes through the away access switch
# on the Security page (see docs/security.md), which covers Tailscale's addresses:
# HUB_AWAY_NETWORKS=["100.64.0.0/10","fd7a:115c:a1e0::/48"]

# Where shared files are stored on the host (Files module). Put this on the SSD on the Pi.
# HUB_FILES_PATH=/mnt/ssd/files
# Largest single upload, in MB.
# HUB_MAX_UPLOAD_MB=8192

# The Claude page (owner only, see docs/claude-usage.md). Point this at Claude Code's logs on
# the Pi to see tokens per day; they're mounted read-only.
# HUB_CLAUDE_LOGS=/home/you/.claude/projects
# Optional: an Admin API key (sk-ant-admin..., console organisations only) to also show spend
# on Anthropic API keys. Only ever sent to api.anthropic.com.
# HUB_ANTHROPIC_ADMIN_KEY=

# Trading: index prices from IG's API (see docs/trading.md). Get the API key under My Account >
# Settings > API keys on IG. A demo account's key is safest: it can never touch real money.
# HUB_IG_API_KEY=
# HUB_IG_USERNAME=
# HUB_IG_PASSWORD=
# HUB_IG_DEMO=true
