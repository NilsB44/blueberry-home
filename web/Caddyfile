{
	# Local network only: Caddy runs its own certificate authority.
	# Install its root certificate on your devices once (see docs/pi-setup.md).
	local_certs
}

{$HUB_HOSTNAME:hub.home} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		# Only the hub's own files and API: no outside scripts, fonts, trackers or frames.
		# Inline scripts and styles stay allowed because SvelteKit's start-up script and
		# component styles are inline.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' wss://{host} ws://{host}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000 {
			# Stream assistant replies token by token instead of buffering.
			flush_interval -1
		}
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
